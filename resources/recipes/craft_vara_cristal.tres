[gd_resource type="Resource" script_class="CraftRecipe" load_steps=8 format=3]

[ext_resource type="Script" path="res://scripts/data/craft_recipe.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/data/craft_recipe_input.gd" id="2_input"]
[ext_resource type="Script" path="res://scripts/data/material_data.gd" id="3_matdata"]
[ext_resource type="Script" path="res://scripts/data/item_data.gd" id="4_itemdata"]
[ext_resource type="Resource" path="res://resources/materials/savia_resonante.tres" id="5_savia"]
[ext_resource type="Resource" path="res://resources/materials/esencia_verdor.tres" id="6_esencia"]
[ext_resource type="Resource" path="res://resources/materials/piedra_resonancia.tres" id="7_piedra"]
[ext_resource type="Resource" path="res://resources/items/weapons/vara_cristal.tres" id="8_output"]

[sub_resource type="Resource" id="Input_savia"]
script = ExtResource("2_input")
material = ExtResource("5_savia")
count = 3

[sub_resource type="Resource" id="Input_esencia"]
script = ExtResource("2_input")
material = ExtResource("6_esencia")
count = 2

[sub_resource type="Resource" id="Input_piedra"]
script = ExtResource("2_input")
material = ExtResource("7_piedra")
count = 3

[resource]
script = ExtResource("1_recipe")
id = &"craft_vara_cristal"
display_name = "Conjurar Vara de Cristal"
description = "La Esencia del Verdor condensa en cristal bajo la presión de las Piedras. Requiere materiales raros del Valle profundo."
inputs = [SubResource("Input_savia"), SubResource("Input_esencia"), SubResource("Input_piedra")]
output_item = ExtResource("8_output")
gold_cost = 800
required_player_level = 1
