[ext_resource type="Resource" path="res://resources/materials/savia_resonante.tres" id="6_savia"]
[ext_resource type="Resource" path="res://resources/materials/esencia_verdor.tres" id="7_esencia"]
[ext_resource type="Resource" path="res://resources/materials/piedra_resonancia.tres" id="8_piedra"]
