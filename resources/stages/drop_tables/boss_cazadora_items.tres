[gd_resource type="Resource" script_class="DropTable" format=3 uid="uid://dt_boss_cazadora_items"]

[ext_resource type="Script" path="res://scripts/data/drop_table.gd" id="1_dttable"]
[ext_resource type="Script" path="res://scripts/data/drop_entry.gd" id="2_dtentry"]
[ext_resource type="Resource" path="res://resources/items/weapons/vara_cristal.tres" id="3_vara_cristal"]
[ext_resource type="Resource" path="res://resources/items/armor/manto_raices.tres" id="4_manto_raices"]
[ext_resource type="Resource" path="res://resources/items/shields/baluarte_terreo.tres" id="5_baluarte_terreo"]
[ext_resource type="Resource" path="res://resources/items/weapons/martillo_guardian.tres" id="6_martillo_guardian"]

; Cazadora elem AGUA. No hay items AGUA R3 hoy; reuso pool R3 mixto (vara, manto, baluarte).
; Si en el futuro hay R3 AGUA, agregar acá.

[sub_resource type="Resource" id="Entry_caz_vara"]
script = ExtResource("2_dtentry")
drop_type = 0
item_data = ExtResource("3_vara_cristal")
material_count_min = 1
material_count_max = 1
weight = 1.0
drop_chance = 0.45

[sub_resource type="Resource" id="Entry_caz_manto"]
script = ExtResource("2_dtentry")
drop_type = 0
item_data = ExtResource("4_manto_raices")
material_count_min = 1
material_count_max = 1
weight = 1.0
drop_chance = 0.30

[sub_resource type="Resource" id="Entry_caz_baluarte"]
script = ExtResource("2_dtentry")
drop_type = 0
item_data = ExtResource("5_baluarte_terreo")
material_count_min = 1
material_count_max = 1
weight = 1.0
drop_chance = 0.25

[sub_resource type="Resource" id="Entry_caz_r4"]
script = ExtResource("2_dtentry")
drop_type = 0
item_data = ExtResource("6_martillo_guardian")
material_count_min = 1
material_count_max = 1
weight = 1.0
drop_chance = 0.05

[resource]
script = ExtResource("1_dttable")
entries = Array[ExtResource("2_dtentry")]([SubResource("Entry_caz_vara"), SubResource("Entry_caz_manto"), SubResource("Entry_caz_baluarte"), SubResource("Entry_caz_r4")])
