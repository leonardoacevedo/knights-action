[gd_resource type="Resource" script_class="StageData" load_steps=6 format=3 uid="uid://stg_zona4_e3"]

; Mini-boss etapa: Capitán de los Vientos (Archer R3 Elite). Sin stage type dedicado,
; usamos 1 entry R3 ARCHER + display_name distinguido. Para mini-boss banner UI propio,
; agregar campo `is_mini_boss: bool` a StageData (futura iteración).

[ext_resource type="Script" path="res://scripts/data/stage_data.gd" id="1_stage"]
[ext_resource type="Script" path="res://scripts/data/enemy_spawn_entry.gd" id="2_entry"]
[ext_resource type="Resource" path="res://resources/stages/drop_tables/zona4_materials.tres" id="3_drops"]
[ext_resource type="Resource" path="res://resources/enemies/drop_tables/enemy_r3_materials.tres" id="6_dr3"]

[sub_resource type="Resource" id="Entry_z4e3_archer_r3"]
script = ExtResource("2_entry")
enemy_class = 2
rarity = 2
count = 1
element = 4
material_drops = ExtResource("6_dr3")

[resource]
script = ExtResource("1_stage")
stage_index = 3
display_name = "Capitán de los Vientos"
subtitle = "Plataforma diminuta suspendida en el vacío. Un Archer R3 te apunta con su láser rojo."
spawns = Array[ExtResource("2_entry")]([SubResource("Entry_z4e3_archer_r3")])
is_boss = false
is_mini_boss = true
ambient_tint = Color(0.75, 0.55, 1.20, 1.0)
hide_default_platforms = true
material_drops = ExtResource("3_drops")
