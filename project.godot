; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Knights Action"
run/main_scene="res://scenes/ui/main_menu.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

GameConfig="*res://scripts/systems/game_config.gd"
MomentumSystem="*res://scripts/systems/momentum_system.gd"
InventorySystem="*res://scripts/systems/inventory_system.gd"
StageManager="*res://scripts/systems/stage_manager.gd"
DropSystem="*res://scripts/systems/drop_system.gd"
UpgradeManager="*res://scripts/systems/upgrade_manager.gd"
CraftingSystem="*res://scripts/systems/crafting_system.gd"
HitStop="*res://scripts/systems/hit_stop.gd"
CameraShake="*res://scripts/systems/camera_shake.gd"
PlayerProgression="*res://scripts/systems/player_progression.gd"
ExperienceSystem="*res://scripts/systems/experience_system.gd"
SetBonusSystem="*res://scripts/systems/set_bonus_system.gd"
GoldSystem="*res://scripts/systems/gold_system.gd"
TestArenaConfig="*res://scripts/systems/test_arena_config.gd"
SaveSystem="*res://scripts/systems/save_system.gd"

